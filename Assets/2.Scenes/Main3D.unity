  m_text: "\xB7 \uC218\uC911\uC5D0\uC11C \uACE0\uCCA0\uACFC \uC624\uC5FC \uC0D8\uD50C\uC744
    \uC218\uC9D1\uD574 \uAC70\uC810\uC73C\uB85C \uAC00\uC838\uC635\uB2C8\uB2E4.\n\xB7
