  m_text: "\xB7 \uC218\uC911\uC5D0\uC11C \uACE0\uCCA0\uACFC \uC624\uC5FC \uC0D8\uD50C\uC744
    \uC218\uC9D1\uD574 \uAC70\uC810\uC73C\uB85C \uAC00\uC838\uC635\uB2C8\uB2E4.\n\xB7
    \uBC30\uD130\uB9AC \uBC29\uC804\xB7\uC801\uC7AC \uD55C\uACC4\xB7\uC624\uC5FC\uC6D0
    \uCDA9\uB3CC \uC804\uC5D0 \uBCF5\uADC0\uD558\uC138\uC694.\n\xB7 \uC5F0\uAD6C\uB85C
    \uC815\uD654\uC81C\uB97C \uD574\uAE08\uD558\uACE0, \uC81C\uC791\uC73C\uB85C \uC815\uD654
    \uBD80\uC720\uCCB4\uB97C \uB9CC\uB4ED\uB2C8\uB2E4.\n\xB7 \uBD80\uC720\uCCB4 \uB2E8\uACC4\uAC00
